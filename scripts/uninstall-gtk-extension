#!/bin/bash

set -euo pipefail

config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
hook_target="$config_root/omarchy/hooks/theme-set.d/ceres-gtk-theme-set"

if [[ -x "$hook_target" ]]; then
  "$hook_target" none
  rm -f "$hook_target"
fi

printf 'Ceres GTK extension removed. Reopen running GTK apps to apply it.\n'
