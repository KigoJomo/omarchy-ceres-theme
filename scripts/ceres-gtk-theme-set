#!/bin/bash

set -euo pipefail

theme_slug="${1:-}"
config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
theme_root="$config_root/omarchy/themes/ceres"
gtk3_dir="$config_root/gtk-3.0"
gtk4_dir="$config_root/gtk-4.0"
gtk3_target="$gtk3_dir/gtk.css"
gtk4_target="$gtk4_dir/gtk.css"
marker='/* Ceres theme: managed GTK override. */'
has_marker() {
  local target="$1"
  [[ -f "$target" ]] && [[ "$(head -n 1 "$target")" == "$marker" ]]
}

apply_override() {
  local source="$1"
  local target="$2"
  local target_dir="$3"

  if [[ -e "$target" || -L "$target" ]] && ! has_marker "$target"; then
    printf 'Ceres GTK hook: preserving existing user file %s\n' "$target" >&2
    return
  fi

  install -d -m 0755 "$target_dir"
  install -m 0644 "$source" "$target"
}

remove_override() {
  local target="$1"

  if has_marker "$target"; then
    rm -f "$target"
  fi
}

if [[ "$theme_slug" == "ceres" ]]; then
  [[ -f "$theme_root/gtk-3.0.css" && -f "$theme_root/gtk-4.0.css" ]] || {
    printf 'Ceres GTK hook: theme stylesheets are missing from %s\n' "$theme_root" >&2
    exit 1
  }
  apply_override "$theme_root/gtk-3.0.css" "$gtk3_target" "$gtk3_dir"
  apply_override "$theme_root/gtk-4.0.css" "$gtk4_target" "$gtk4_dir"
else
  remove_override "$gtk3_target"
  remove_override "$gtk4_target"
fi
